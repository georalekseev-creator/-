        end
        
        local function disableFreecam()
            if not isFreecamActive then return end
            
            local player = game.Players.LocalPlayer
            local char = player and player.Character
            local humanoid = char and char:FindFirstChild("Humanoid")
            local camera = workspace.CurrentCamera
            
            isFreecamActive = false
            isCursorLocked = false
            
            game:GetService("UserInputService").MouseBehavior = Enum.MouseBehavior.Default
            
            -- Восстанавливаем камеру
            if savedCameraCFrame then
                camera.CFrame = savedCameraCFrame
                camera.Focus = savedCameraFocus
            end
            
            -- Восстанавливаем персонажа (БЕЗ ИЗМЕНЕНИЯ ПРОЗРАЧНОСТИ)
            if char and char:FindFirstChild("HumanoidRootPart") then
                char.HumanoidRootPart.Anchored = savedAnchored or false
            end
            
            if humanoid then
                humanoid.AutoRotate = savedAutoRotate
                humanoid.PlatformStand = savedPlatformStand
                humanoid.WalkSpeed = savedWalkSpeed
                humanoid.JumpPower = savedJumpPower
            end
            
            -- Восстанавливаем позицию персонажа
            if savedCharacterCFrame and char and char:FindFirstChild("HumanoidRootPart") then
                char.HumanoidRootPart.CFrame = savedCharacterCFrame
            end
            
            toggleBtn.Text = "ВЫКЛ"
            toggleBtn.BackgroundColor3 = Color3.fromRGB(200, 40, 40)
            statusLabel.Text = "Freecam: Выключен"
            statusLabel.TextColor3 = Color3.fromRGB(200, 40, 40)
            
            print("✅ Freecam выключен. Персонаж восстановлен.")
        end
        
        local function toggleFreecam()
            if isFreecamActive then
                disableFreecam()
            else
                enableFreecam()
            end
        end
        
        toggleBtn.MouseButton1Click:Connect(toggleFreecam)
        
        local draggingSpeed = false
        speedButton.MouseButton1Down:Connect(function() draggingSpeed = true end)
        
        game:GetService("UserInputService").InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                draggingSpeed = false
            end
        end)
        
        game:GetService("UserInputService").InputChanged:Connect(function(input)
            if draggingSpeed and input.UserInputType == Enum.UserInputType.MouseMovement then
                local sliderPos = speedSlider.AbsolutePosition
                local sliderSize = speedSlider.AbsoluteSize
                local mouseX = input.Position.X
                
                local percent = math.clamp((mouseX - sliderPos.X) / sliderSize.X, 0, 1)
                baseSpeed = math.floor(1 + percent * 199)
                updateSpeedSlider()
                moveSpeed = baseSpeed
            end
        end)
        
        local inputService = game:GetService("UserInputService")
        
        inputService.InputBegan:Connect(function(input, gameProcessed)
            if gameProcessed then return end
            
            if input.KeyCode == Enum.KeyCode.F9 then
                toggleFreecam()
            end
            
            if input.KeyCode == Enum.KeyCode.LeftAlt or input.KeyCode == Enum.KeyCode.RightAlt then
                if isFreecamActive then
                    if isCursorLocked then
                        inputService.MouseBehavior = Enum.MouseBehavior.Default
                        isCursorLocked = false
                    else
                        inputService.MouseBehavior = Enum.MouseBehavior.LockCenter
                        isCursorLocked = true
                    end
                end
            end
        end)
        
        -- Плавное вращение через умножение CFrame
        inputService.InputChanged:Connect(function(input)
            if not isFreecamActive then return end
            if not isCursorLocked then return end
            
            if input.UserInputType == Enum.UserInputType.MouseMovement then
                local deltaX = -input.Delta.X * sensitivity
                local deltaY = -input.Delta.Y * sensitivity
                
                local rotY = CFrame.Angles(0, deltaX, 0)
                local rotX = CFrame.Angles(deltaY, 0, 0)
                
                cameraRotation = cameraRotation * rotY
                cameraRotation = cameraRotation * rotX
                
                -- Нормализация CFrame
                local pos = cameraRotation.Position
                local look = cameraRotation.LookVector
                local up = cameraRotation.UpVector
                cameraRotation = CFrame.lookAt(pos, pos + look, up)
            end
        end)
        
        -- Обновление камеры
        game:GetService("RunService").RenderStepped:Connect(function()
            if not isFreecamActive then return end
            
            local camera = workspace.CurrentCamera
            local moveDirection = Vector3.new(0, 0, 0)
            
            if inputService:IsKeyDown(Enum.KeyCode.W) then moveDirection = moveDirection + Vector3.new(0, 0, -1) end
            if inputService:IsKeyDown(Enum.KeyCode.S) then moveDirection = moveDirection + Vector3.new(0, 0, 1) end
            if inputService:IsKeyDown(Enum.KeyCode.A) then moveDirection = moveDirection + Vector3.new(-1, 0, 0) end
            if inputService:IsKeyDown(Enum.KeyCode.D) then moveDirection = moveDirection + Vector3.new(1, 0, 0) end
            if inputService:IsKeyDown(Enum.KeyCode.Space) then moveDirection = moveDirection + Vector3.new(0, 1, 0) end
            if inputService:IsKeyDown(Enum.KeyCode.LeftControl) then moveDirection = moveDirection + Vector3.new(0, -1, 0) end
            
            if moveDirection.Magnitude > 0 then moveDirection = moveDirection.Unit end
            
            local deltaTime = 0.016
            local moveAmount = moveSpeed * deltaTime
            
            if moveDirection.Magnitude > 0 then
                local worldMove = cameraRotation * moveDirection
                freecamPosition = freecamPosition + worldMove * moveAmount
            end
            
            local newCFrame = CFrame.new(freecamPosition) * cameraRotation
            
            camera.CFrame = newCFrame
            camera.Focus = CFrame.new(freecamPosition + cameraRotation.LookVector * 100)
        end)
        
        updateSpeedSlider()
        
        print("========================================")
        print("✅ FREECAM ИСПРАВЛЕНА!")
        print("📌 Персонаж НЕ становится прозрачным")
        print("📌 Плавное вращение через CFrame")
        print("📌 F9 - вкл/выкл | Alt - курсор | WASD - движение")
        print("========================================")
    end
    
    createFreecamUI()
end

