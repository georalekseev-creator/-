        local function beginLook(input)
            if not FC.isActive then return end
            if input.UserInputType ~= Enum.UserInputType.Touch then return end
            if lookTouchId ~= nil then return end

            if MenuPanel and MenuPanel.Visible then
                local mp = MenuPanel.AbsolutePosition
