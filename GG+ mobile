    transFill.BorderSizePixel = 0
    transFill.BackgroundTransparency = 0
    transFill.Parent = transSlider

    local transButton = Instance.new("TextButton")
    transButton.Name = "OrionSliderButton"
    transButton.Size = UDim2.new(0, 7, 0, 7)
    transButton.Position = UDim2.new(0.5, -3.5, 0.5, -3.5)
    transButton.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    transButton.BorderSizePixel = 0
    transButton.Text = ""
    transButton.Parent = transSlider
    transButton.BackgroundTransparency = 0

    local transCorner = Instance.new("UICorner")
    transCorner.CornerRadius = UDim.new(1, 0)
    transCorner.Parent = transButton

    local xrayEnabled = false
    local currentTransparency = 0.5
    local originalTransparencies = {}

    local function makeXRayPart(part, enable)
        if not part or not part.Parent then return end

        if enable then
            if not originalTransparencies[part] then
                originalTransparencies[part] = part.LocalTransparencyModifier or 0
            end
            part.LocalTransparencyModifier = currentTransparency
        else
            if originalTransparencies[part] ~= nil then
                part.LocalTransparencyModifier = originalTransparencies[part]
                originalTransparencies[part] = nil
            end
        end
    end

    local function processParts(object, enable)
        if object:IsA("BasePart") then
            makeXRayPart(object, enable)
        end

        if object:FindFirstChildOfClass("Humanoid") then return end
        if object:IsDescendantOf(game.Players.LocalPlayer.Character) then return end
        if object:IsDescendantOf(game.CoreGui) then return end
        if object:IsDescendantOf(game.StarterGui) then return end

        for _, child in pairs(object:GetChildren()) do
            processParts(child, enable)
        end
    end

    local function updateTransparency()
        if xrayEnabled then
            for part, _ in pairs(originalTransparencies) do
                if part and part.Parent then
                    part.LocalTransparencyModifier = currentTransparency
                else
                    originalTransparencies[part] = nil
                end
            end
        end
    end

    local function enableXRay()
        if xrayEnabled then return end
        xrayEnabled = true

        originalTransparencies = {}

        processParts(workspace, true)

        xrayBtn.Text = "ON"
        xrayBtn.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
    end

    local function disableXRay()
        if not xrayEnabled then return end
        xrayEnabled = false

        for part, origTrans in pairs(originalTransparencies) do
            if part and part.Parent then
                part.LocalTransparencyModifier = origTrans
            end
        end
        originalTransparencies = {}

        xrayBtn.Text = "OFF"
        xrayBtn.BackgroundColor3 = Color3.fromRGB(200, 40, 40)
    end

    local function toggleXRay()
        if xrayEnabled then
            disableXRay()
        else
            enableXRay()
        end
    end

    local function updateSlider()
        local percent = currentTransparency
        transFill.Size = UDim2.new(percent, 0, 1, 0)
        transButton.Position = UDim2.new(percent, -3.5, 0.5, -3.5)
        transLabel.Text = math.floor(percent * 100) .. "%"
    end

    xrayBtn.MouseButton1Click:Connect(toggleXRay)

    local isDragging = false
    transButton.MouseButton1Down:Connect(function() isDragging = true end)

    game:GetService("UserInputService").InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            isDragging = false
        end
    end)

    game:GetService("UserInputService").InputChanged:Connect(function(input)
        if isDragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local sliderPos = transSlider.AbsolutePosition
            local sliderSize = transSlider.AbsoluteSize
            local mouseX = input.Position.X

            local percent = math.clamp((mouseX - sliderPos.X) / sliderSize.X, 0, 1)
            currentTransparency = percent
            updateSlider()
            updateTransparency()
        end
    end)

    updateSlider()

    game.Players.LocalPlayer.CharacterAdded:Connect(function()
        if xrayEnabled then
            task.wait(0.5)
            originalTransparencies = {}
            processParts(workspace, true)
        end
    end)
end)

