    local startPos = nil
    local isDraggingButton = false

    MainButton.InputBegan:Connect(function(input)
        если input.UserInputType == Enum.UserInputType.MouseButton1, то
            dragging = true
            isDraggingButton = true
            dragStart = input.Position
            startPos = MainButton.Position
            input.StopPropagation = true
        конец
    конец)

    MainButton.InputChanged:Connect(function(input)
        Если выполняется перетаскивание, и переменная isDraggingButton, а input.UserInputType == Enum.UserInputType.MouseMovement, то
            local delta = input.Position - dragStart
            MainButton.Position = UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )
        конец
    конец)

    MainButton.InputEnded:Connect(function(input)
        если input.UserInputType == Enum.UserInputType.MouseButton1, то
            dragging = false
            isDraggingButton = false
        конец
    конец)
