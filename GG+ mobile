        local function updateSpeedSlider()
            local percent = (FC.baseSpeed - 1) / (FC.maxSpeed - 1)
            speedFill.Size = UDim2.new(percent, 0, 1, 0)
            speedButton.Position = UDim2.new(percent, -3.5, 0.5, -3.5)
            speedTitle.Text = "Speed: " .. math.floor(FC.baseSpeed)
        end

        local function enableFreecam()
            if FC.isActive then return end

            local player = game.Players.LocalPlayer
            local char = player and player.Character
            local humanoid = char and char:FindFirstChild("Humanoid")
            local camera = workspace.CurrentCamera

            FC.savedCameraCFrame = camera.CFrame
            FC.savedCameraFocus = camera.Focus

            if char and char:FindFirstChild("HumanoidRootPart") then
                FC.savedCharacterCFrame = char.HumanoidRootPart.CFrame
                FC.freecamPosition = FC.savedCameraCFrame.Position
            else
                FC.freecamPosition = camera.CFrame.Position
            end

            if humanoid then
                FC.savedWalkSpeed = humanoid.WalkSpeed
                FC.savedJumpPower = humanoid.JumpPower
                FC.savedAutoRotate = humanoid.AutoRotate
                FC.savedPlatformStand = humanoid.PlatformStand
                humanoid.AutoRotate = false
                humanoid.PlatformStand = false
                humanoid.WalkSpeed = 16
                humanoid.JumpPower = 50
            end

            FC.cameraRotation = CFrame.new(FC.savedCameraCFrame.Position, FC.savedCameraCFrame.Position + FC.savedCameraCFrame.LookVector)

            if char and char:FindFirstChild("HumanoidRootPart") then
                FC.savedAnchored = char.HumanoidRootPart.Anchored
                char.HumanoidRootPart.Anchored = true
            end

            FC.isActive = true

            toggleBtn.Text = "ON"
            toggleBtn.BackgroundColor3 = Library.Theme.Success

            createLookLayer()
            if LookGui then LookGui.Enabled = true end
        end

        local function disableFreecam()
            if not FC.isActive then return end

            local player = game.Players.LocalPlayer
            local char = player and player.Character
            local humanoid = char and char:FindFirstChild("Humanoid")
            local camera = workspace.CurrentCamera

            FC.isActive = false

            if FC.savedCameraCFrame then
                camera.CFrame = FC.savedCameraCFrame
                camera.Focus = FC.savedCameraFocus
            end

            if char and char:FindFirstChild("HumanoidRootPart") then
                char.HumanoidRootPart.Anchored = FC.savedAnchored or false
            end

            if humanoid then
                humanoid.AutoRotate = FC.savedAutoRotate
                humanoid.PlatformStand = FC.savedPlatformStand
                humanoid.WalkSpeed = FC.savedWalkSpeed
                humanoid.JumpPower = FC.savedJumpPower
            end

            if FC.savedCharacterCFrame and char and char:FindFirstChild("HumanoidRootPart") then
                char.HumanoidRootPart.CFrame = FC.savedCharacterCFrame
            end

            toggleBtn.Text = "OFF"
            toggleBtn.BackgroundColor3 = Color3.fromRGB(200, 40, 40)

            if LookGui then LookGui.Enabled = false end
        end

        toggleBtn.MouseButton1Click:Connect(function()
            if FC.isActive then disableFreecam() else enableFreecam() end
        end)

        local draggingSpeed = false
        local function updateSpeedFromInput(input)
            local sliderPos = speedSlider.AbsolutePosition
            local sliderSize = speedSlider.AbsoluteSize
            local percent = math.clamp((input.Position.X - sliderPos.X) / sliderSize.X, 0, 1)
            FC.baseSpeed = math.floor(1 + percent * (FC.maxSpeed - 1))
            updateSpeedSlider()
        end

        speedButton.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.Touch
               or input.UserInputType == Enum.UserInputType.MouseButton1 then
                draggingSpeed = true
                updateSpeedFromInput(input)
            end
        end)
        userInputService.InputChanged:Connect(function(input)
            if draggingSpeed and (input.UserInputType == Enum.UserInputType.Touch
               or input.UserInputType == Enum.UserInputType.MouseMovement) then
                updateSpeedFromInput(input)
            end
        end)
        userInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.Touch
               or input.UserInputType == Enum.UserInputType.MouseButton1 then
                draggingSpeed = false
            end
        end)

        if userInputService.KeyboardEnabled then
            userInputService.InputBegan:Connect(function(input, gp)
                if gp then return end
                if input.KeyCode == Enum.KeyCode.F9 then
                    if FC.isActive then disableFreecam() else enableFreecam() end
                end
            end)
            userInputService.InputChanged:Connect(function(input)
                if not FC.isActive then return end
                if input.UserInputType == Enum.UserInputType.MouseMovement then
                    local dx = -input.Delta.X * 0.005
                    local dy = -input.Delta.Y * 0.005
                    FC.cameraRotation = FC.cameraRotation * CFrame.Angles(0, dx, 0) * CFrame.Angles(dy, 0, 0)
                    local look = FC.cameraRotation.LookVector
                    local up = FC.cameraRotation.UpVector
                    FC.cameraRotation = CFrame.lookAt(Vector3.new(0,0,0), look, up)
                end
            end)
        end

        game:GetService("RunService").RenderStepped:Connect(function(dt)
            if not FC.isActive then return end
            local camera = workspace.CurrentCamera
            local moveDirection = Vector3.new(0, 0, 0)

            local camLook = FC.cameraRotation.LookVector
            local camRight = FC.cameraRotation.RightVector
            local flatLook = Vector3.new(camLook.X, 0, camLook.Z)
            local flatRight = Vector3.new(camRight.X, 0, camRight.Z)
            if flatLook.Magnitude > 0.01 then flatLook = flatLook.Unit end
            if flatRight.Magnitude > 0.01 then flatRight = flatRight.Unit end

            if isMobile then
                local player = game.Players.LocalPlayer
                local char = player and player.Character
                local humanoid = char and char:FindFirstChild("Humanoid")

                if humanoid then
                    local md = humanoid.MoveDirection
                    if md.Magnitude > 0.05 then
                        local forwardAmt = md:Dot(flatLook)
                        local rightAmt = md:Dot(flatRight)
                        moveDirection = moveDirection + camLook * forwardAmt
                        moveDirection = moveDirection + flatRight * rightAmt
                    end
                    if humanoid.Jump then
                        moveDirection = moveDirection + Vector3.new(0, 1, 0)
                    end
                end
            end

            if userInputService.KeyboardEnabled then
                if userInputService:IsKeyDown(Enum.KeyCode.W) then
                    moveDirection = moveDirection + camLook
                end
                if userInputService:IsKeyDown(Enum.KeyCode.S) then
                    moveDirection = moveDirection - camLook
                end
                if userInputService:IsKeyDown(Enum.KeyCode.A) then
                    moveDirection = moveDirection - flatRight
                end
                if userInputService:IsKeyDown(Enum.KeyCode.D) then
                    moveDirection = moveDirection + flatRight
                end
                if userInputService:IsKeyDown(Enum.KeyCode.Space) then
                    moveDirection = moveDirection + Vector3.new(0, 1, 0)
                end
                if userInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
                    moveDirection = moveDirection - Vector3.new(0, 1, 0)
                end
            end

            if moveDirection.Magnitude > 0 then
                moveDirection = moveDirection.Unit
            end

            local moveAmount = FC.baseSpeed * dt
            if moveDirection.Magnitude > 0 then
                FC.freecamPosition = FC.freecamPosition + moveDirection * moveAmount
            end

            local newCFrame = CFrame.new(FC.freecamPosition) * (FC.cameraRotation - FC.cameraRotation.Position)
            camera.CFrame = newCFrame
            camera.Focus = CFrame.new(FC.freecamPosition + newCFrame.LookVector * 100)
        end)

        updateSpeedSlider()
    end
end

