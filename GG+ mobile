локальная функция ApplyThemeColors(colors)
    local themeColors = colors or Library.Theme

    Если MenuPanel, то
        MenuPanel.BackgroundColor3 = themeColors.Background
        MenuPanel.BorderColor3 = themeColors.Border
    конец

    если TitleFrame, то
        TitleFrame.BackgroundColor3 = themeColors.Panel
    конец

    Если заголовок, то
        Title.TextColor3 = themeColors.Text
    конец

    если TabBar, то
        TabBar.BackgroundColor3 = themeColors.Panel
        TabBar.BorderColor3 = themeColors.Border
    конец

    если MainButton, то
        MainButton.BackgroundColor3 = themeColors.Panel
        MainButton.BorderColor3 = themeColors.Border
    конец

    for _, child in pairs(MenuPanel:GetChildren()) do
        если child:IsA("ImageButton") тогда
            child.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
            child.BorderColor3 = Color3.fromRGB(0, 200, 255)
        конец
    конец

    локальные панели = {
        PointsList, WalkPointsList, PlayersList, NoclipFrame,
        XRayControlFrame, SPIControlFrame, PlatformFrame,
        WalkFrame, ClickTeleportFrame, PlayersControlPanel
    }
    for _, panel in pairs(panels) do
        если панель, то
            panel.BackgroundColor3 = themeColors.Panel
            panel.BorderColor3 = themeColors.Border
        конец
    конец

    for _, obj in pairs(MenuPanel:GetDescendants()) do
        if obj:IsA("Frame") and obj.BackgroundTransparency < 1 and obj ~= MenuPanel and obj.Parent ~= nil then
            если obj.Name ~= "Wave" и obj.Name ~= "Shadow" и obj.Name ~= "LoadingScreen" и obj.Name ~= "OrionSliderTrack" и obj.Name ~= "OrionSliderFill" тогда
                obj.BackgroundColor3 = themeColors.Panel
                obj.BorderColor3 = themeColors.Border
            конец
        конец
        если obj:IsA("TextLabel") тогда
            если obj.Parent ~= MainButton и obj.Name ~= "ButtonLabel", то
                local isResize = false
                Если obj.Parent и obj.Parent:IsA("ImageButton"), то
                    isResize = true
                конец
                если isResize не равно, то
                    если obj.TextColor3 ~= Color3.fromRGB(200, 40, 40) и
                       obj.TextColor3 ~= Color3.fromRGB(0, 200, 100) and
                       obj.TextColor3 ~= Color3.fromRGB(255, 255, 255) then
                        obj.TextColor3 = themeColors.Text
                    конец
                конец
            конец
        конец
        если obj:IsA("TextButton") тогда
            local isTabButton = false
            для _, кнопка в ipairs(TabButtons) сделать
                if btn == obj then isTabButton = true; break end
            конец
            local isMainButton = (obj == MainButton or obj.Parent == MainButton)
            local isResizeButton = (obj.Parent and obj.Parent:IsA("ImageButton") and obj.Parent.Parent == MenuPanel)

            если isTabButton, isMainButton и isResizeButton, то
                если obj.Text ~= "ON" и obj.Text ~= "OFF", то
                    obj.TextColor3 = themeColors.Text
                конец
            конец
        конец
    конец

    Если PointInfo, то PointInfo.TextColor3 = themeColors.Text.
    Если WalkStatus, то WalkStatus.TextColor3 = themeColors.Text end
    Если NoclipIndicator, то
        Если NoclipEnabled, то
            NoclipIndicator.TextColor3 = Color3.fromRGB(0, 200, 100)
        иначе
            NoclipIndicator.TextColor3 = Color3.fromRGB(200, 40, 40)
        конец
    конец
    Если PlatformInfo, то PlatformInfo.TextColor3 = themeColors.Text.
    if PlayersCountLabel then PlayersCountLabel.TextColor3 = themeColors.Text end
    if SPICountLabel then SPICountLabel.TextColor3 = themeColors.Text end
    если SPIIndicator, то
        Если включена функция SPIEnabled, то
            SPIIndicator.TextColor3 = themeColors.SPI
        иначе
            SPIIndicator.TextColor3 = Color3.fromRGB(200, 40, 40)
        конец
    конец
