local function TeleportToPlayer(targetPlayer)
    local player = game.Players.LocalPlayer
    if not player or not player.Character then
        print("❌ Player or character not found")
        return
    end

    if not targetPlayer then
        print("❌ Target player not found")
        return
    end

    local hrp = player.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then
        print("❌ No HumanoidRootPart for player")
        return
    end

    if not targetPlayer.Character then
        targetPlayer:LoadCharacter()
        task.wait(1)
    end

    local attempts = 0
    while attempts < 5 and not targetPlayer.Character do
        task.wait(0.5)
        attempts = attempts + 1
    end

    if not targetPlayer.Character then
        print("❌ Could not load character for " .. targetPlayer.Name)
        return
    end

    local targetPos = nil

    local targetHrp = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
    if targetHrp then
        targetPos = targetHrp.Position + Vector3.new(0, 3, 0)
        print("✅ Found HumanoidRootPart for " .. targetPlayer.Name)
    else
        local parts = targetPlayer.Character:GetChildren()
        for _, part in pairs(parts) do
            if part:IsA("BasePart") then
                targetPos = part.Position + Vector3.new(0, 3, 0)
                print("✅ Found body part for " .. targetPlayer.Name)
                break
            end
        end
    end

    if targetPos then
        hrp.CFrame = CFrame.new(targetPos)
        print("✅ Teleported to " .. targetPlayer.Name .. " at position " .. tostring(targetPos))
    else
        print("⚠️ No body parts found for " .. targetPlayer.Name .. ", teleporting to center")
        hrp.CFrame = CFrame.new(0, 10, 0)
    end
end

