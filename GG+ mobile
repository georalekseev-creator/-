local collapseAnimating = false
local animationConnection = nil

local function AnimateCollapse(targetCollapsed)
    if collapseAnimating then
        return
    end
    collapseAnimating = true

    if animationConnection then
        animationConnection:Disconnect()
        animationConnection = nil
    end

    local startSize = MenuPanel.Size
    local targetSize, targetPosition

    if targetCollapsed then
        targetSize = UDim2.new(0, 0, 0, 0)
        targetPosition = UDim2.new(
            MainButton.Position.X.Scale,
            MainButton.Position.X.Offset + (MainButton.Size.X.Offset / 2),
            MainButton.Position.Y.Scale,
            MainButton.Position.Y.Offset + (MainButton.Size.Y.Offset / 2)
        )
    else
        targetSize = UDim2.new(0, 375, 0, 325)
        targetPosition = UDim2.new(0.5, -187.5, 0.5, -162.5)
    end

    local startPos = MenuPanel.Position
    local startTime = tick()
    local duration = 0.4

    animationConnection = game:GetService("RunService").RenderStepped:Connect(function()
        local elapsed = tick() - startTime
        local progress = math.min(elapsed / duration, 1)

        local eased = progress < 0.5 and (2 * progress * progress) or (1 - math.pow(-2 * progress + 2, 2) / 2)

        local currentWidth = startSize.X.Offset + (targetSize.X.Offset - startSize.X.Offset) * eased
        local currentHeight = startSize.Y.Offset + (targetSize.Y.Offset - startSize.Y.Offset) * eased

        MenuPanel.Size = UDim2.new(0, currentWidth, 0, currentHeight)

        local posX = startPos.X.Offset + (targetPosition.X.Offset - startPos.X.Offset) * eased
        local posY = startPos.Y.Offset + (targetPosition.Y.Offset - startPos.Y.Offset) * eased
        MenuPanel.Position = UDim2.new(
            startPos.X.Scale + (targetPosition.X.Scale - startPos.X.Scale) * eased,
            posX,
            startPos.Y.Scale + (targetPosition.Y.Scale - startPos.Y.Scale) * eased,
            posY
        )

        local scale = 1 - (1 - (currentWidth / 375)) * 0.5
        MainButton.Size = UDim2.new(0, 25 * (1 + (1 - scale) * 0.5), 0, 25 * (1 + (1 - scale) * 0.5))

        if progress >= 1 then
            MenuPanel.Size = targetSize
            MenuPanel.Position = targetPosition
            MenuPanel.Visible = not targetCollapsed

            if targetCollapsed then
                MenuPanel.BackgroundTransparency = 1
            else
                MenuPanel.BackgroundTransparency = 0.5
            end

            isCollapsed = targetCollapsed
            menuOpen = not targetCollapsed
            collapseAnimating = false

            if animationConnection then
                animationConnection:Disconnect()
                animationConnection = nil
            end

            print("Animation complete! menuOpen=" .. tostring(menuOpen) .. ", isCollapsed=" .. tostring(isCollapsed))
        end
    end)
end

local function ToggleMenu()
    if collapseAnimating then
        return
    end

    if menuOpen and not isCollapsed then
        print("Toggling: Collapse")
        AnimateCollapse(true)
    elseif not menuOpen or isCollapsed then
        print("Toggling: Expand")
        MenuPanel.BackgroundTransparency = 0.5
