-- ===== TAB 3: FLY (Solara Edition) - FIXED =====
local FlyTab = Tabs[3]

do
    local FLY_CONFIG = {
        flySpeed = 100,
        maxSpeed = 300,
        minSpeed = 10,
        jumpSpeed = 45,
        acceleration = 8,
        deceleration = 10,
        deadzone = 0.05,
        mobileJumpHoldTime = 0.25,
    }

    local flying = false
    local bodyVelocity, bodyGyro, flyConnection
    local currentVelocity = Vector3.new(0, 0, 0)
    local targetVelocity = Vector3.new(0, 0, 0)
    local jumpHeld = false
    local lastJumpRequest = 0
    local flyWasActiveBeforeDeath = false
    local flyJustStarted = false

    local player = game.Players.LocalPlayer
    local userInputService = game:GetService("UserInputService")
    local runService = game:GetService("RunService")

    local flyToggleBtn

    local function lerpVelocity(current, target, alpha)
        return current:Lerp(target, alpha)
    end

    local function stopFly()
        if not flying then return end
        flying = false

        if flyToggleBtn then
            flyToggleBtn.Text = "OFF"
            flyToggleBtn.BackgroundColor3 = Color3.fromRGB(200, 40, 40)
            flyToggleBtn.BorderColor3 = Library.Theme.Border
        end

        jumpHeld = false
        currentVelocity = Vector3.new(0, 0, 0)
        targetVelocity = Vector3.new(0, 0, 0)
        flyJustStarted = false

        if flyConnection then flyConnection:Disconnect(); flyConnection = nil end
        if bodyVelocity then bodyVelocity:Destroy(); bodyVelocity = nil end
        if bodyGyro then bodyGyro:Destroy(); bodyGyro = nil end

        local character = player.Character
        if character then
            local humanoid = character:FindFirstChildOfClass("Humanoid")
            if humanoid then
                humanoid.PlatformStand = false
                humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
                task.wait(0.1)
                humanoid:ChangeState(Enum.HumanoidStateType.Running)
            end

            local rootPart = character:FindFirstChild("HumanoidRootPart")
            if rootPart then
                for _, obj in ipairs(rootPart:GetChildren()) do
                    if obj:IsA("BodyVelocity") or obj:IsA("BodyGyro")
                       or obj:IsA("BodyForce") or obj:IsA("BodyThrust") then
                        obj:Destroy()
                    end
                end
            end
        end
    end

    local function startFly()
        if flyToggleBtn then
            flyToggleBtn.Text = "ON"
            flyToggleBtn.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
            flyToggleBtn.BorderColor3 = Color3.fromRGB(0, 255, 100)
        end

        local character = player.Character
        if not character then
            if flyToggleBtn then
                flyToggleBtn.Text = "OFF"
                flyToggleBtn.BackgroundColor3 = Color3.fromRGB(200, 40, 40)
                flyToggleBtn.BorderColor3 = Library.Theme.Border
            end
            warn("[FLY] No character")
            return
        end

        local rootPart = character:FindFirstChild("HumanoidRootPart")
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if not rootPart or not humanoid then
            if flyToggleBtn then
                flyToggleBtn.Text = "OFF"
                flyToggleBtn.BackgroundColor3 = Color3.fromRGB(200, 40, 40)
                flyToggleBtn.BorderColor3 = Library.Theme.Border
            end
            warn("[FLY] No HumanoidRootPart or Humanoid")
            return
        end

        flying = true
        flyJustStarted = true

        humanoid.PlatformStand = true

        bodyVelocity = Instance.new("BodyVelocity")
        bodyVelocity.Name = "FlyBodyVelocity"
        bodyVelocity.MaxForce = Vector3.new(100000, 100000, 100000)
        bodyVelocity.Velocity = Vector3.new(0, 0, 0)
        bodyVelocity.Parent = rootPart

        bodyGyro = Instance.new("BodyGyro")
        bodyGyro.Name = "FlyBodyGyro"
        bodyGyro.MaxTorque = Vector3.new(100000, 100000, 100000)
        bodyGyro.P = 15000
        bodyGyro.D = 500
        bodyGyro.Parent = rootPart

        flyConnection = runService.RenderStepped:Connect(function(dt)
            if not flying then return end

            local currentChar = player.Character
            local currentRoot = currentChar and currentChar:FindFirstChild("HumanoidRootPart")
            local currentHumanoid = currentChar and currentChar:FindFirstChildOfClass("Humanoid")
            if not currentRoot or not currentHumanoid then
                task.wait(0.5)
                if not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then
                    stopFly()
                end
                return
            end

            local camera = workspace.CurrentCamera
            if not camera then return end

            local camLook = camera.CFrame.LookVector
            local camRight = camera.CFrame.RightVector
            local desired = Vector3.new(0, 0, 0)

            local moveDir = Vector3.new(0, 0, 0)
            if userInputService:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + camLook end
            if userInputService:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - camLook end
            if userInputService:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - camRight end
            if userInputService:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + camRight end

            local humanoidMove = currentHumanoid.MoveDirection
            if humanoidMove.Magnitude > FLY_CONFIG.deadzone then
                local worldMove = humanoidMove.Unit
                local forwardDot = worldMove:Dot(camLook)
                local rightDot = worldMove:Dot(camRight)
                moveDir = moveDir + (camLook * forwardDot + camRight * rightDot)
            end

            if moveDir.Magnitude > 0.001 then
                moveDir = moveDir.Unit
                desired = moveDir * FLY_CONFIG.flySpeed
            end

            if jumpHeld then
                desired = desired + Vector3.new(0, FLY_CONFIG.jumpSpeed, 0)
            end

            if userInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
                desired = desired + Vector3.new(0, -FLY_CONFIG.jumpSpeed, 0)
            end

            targetVelocity = desired

            local alpha
            if targetVelocity.Magnitude > 0.1 then
                alpha = math.clamp(dt * FLY_CONFIG.acceleration, 0, 1)
            else
                alpha = math.clamp(dt * FLY_CONFIG.deceleration, 0, 1)
            end

            currentVelocity = lerpVelocity(currentVelocity, targetVelocity, alpha)

            if bodyVelocity and bodyVelocity.Parent then
                bodyVelocity.Velocity = currentVelocity
            end
            if bodyGyro and bodyGyro.Parent then
                bodyGyro.CFrame = camera.CFrame
            end

            flyJustStarted = false
        end)
    end

    local FlyFrame = Instance.new("Frame")
    FlyFrame.Size = UDim2.new(1, 0, 0.85, 0)
    FlyFrame.Position = UDim2.new(0, 0, 0.05, 0)
    FlyFrame.BackgroundColor3 = Library.Theme.Panel
    FlyFrame.BorderColor3 = Library.Theme.Border
    FlyFrame.BorderSizePixel = 2
    FlyFrame.Parent = FlyTab

    local FlyTitle = Instance.new("TextLabel")
    FlyTitle.Size = UDim2.new(1, 0, 0.1, 0)
    FlyTitle.BackgroundTransparency = 1
    FlyTitle.Text = "FLY"
    FlyTitle.TextColor3 = Library.Theme.Text
    FlyTitle.TextScaled = true
    FlyTitle.Font = Enum.Font.SourceSansBold
    FlyTitle.Parent = FlyFrame

    flyToggleBtn = Instance.new("TextButton")
    flyToggleBtn.Size = UDim2.new(0.4, -5, 0.15, -2.5)
    flyToggleBtn.Position = UDim2.new(0.3, 0, 0.15, 0)
    flyToggleBtn.BackgroundColor3 = Color3.fromRGB(200, 40, 40)
    flyToggleBtn.BorderColor3 = Library.Theme.Border
    flyToggleBtn.BorderSizePixel = 2
    flyToggleBtn.Text = "OFF"
    flyToggleBtn.TextColor3 = Library.Theme.Text
    flyToggleBtn.TextScaled = true
    flyToggleBtn.Font = Enum.Font.SourceSansBold
    flyToggleBtn.Parent = FlyFrame

    -- ===== VERнутая надпись скорости =====
    local flySpeedTitle = Instance.new("TextLabel")
    flySpeedTitle.Size = UDim2.new(0.3, 0, 0.08, 0)
    flySpeedTitle.Position = UDim2.new(0.05, 0, 0.43, 0)
    flySpeedTitle.BackgroundTransparency = 1
    flySpeedTitle.Text = "Speed: " .. FLY_CONFIG.flySpeed
    flySpeedTitle.TextColor3 = Library.Theme.Text
    flySpeedTitle.TextScaled = true
    flySpeedTitle.Font = Enum.Font.SourceSans
    flySpeedTitle.TextXAlignment = Enum.TextXAlignment.Left
    flySpeedTitle.Parent = FlyFrame

    -- ===== ORION STYLE SLIDER (непрозрачный) =====
    local flySpeedSlider = Instance.new("Frame")
    flySpeedSlider.Name = "OrionSliderTrack"
    flySpeedSlider.Size = UDim2.new(0.55, -5, 0, 3)
    flySpeedSlider.Position = UDim2.new(0.4, 0, 0.45, 0)
    flySpeedSlider.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    flySpeedSlider.BorderSizePixel = 0
    flySpeedSlider.BackgroundTransparency = 0
    flySpeedSlider.Parent = FlyFrame

    local flySpeedFill = Instance.new("Frame")
    flySpeedFill.Name = "OrionSliderFill"
    flySpeedFill.Size = UDim2.new(0.3, 0, 1, 0)
    flySpeedFill.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    flySpeedFill.BorderSizePixel = 0
    flySpeedFill.BackgroundTransparency = 0
    flySpeedFill.Parent = flySpeedSlider

    local flySpeedButton = Instance.new("TextButton")
    flySpeedButton.Name = "OrionSliderButton"
    flySpeedButton.Size = UDim2.new(0, 7, 0, 7)
    flySpeedButton.Position = UDim2.new(0.3, -3.5, 0.5, -3.5)
    flySpeedButton.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    flySpeedButton.BorderSizePixel = 0
    flySpeedButton.Text = ""
    flySpeedButton.Parent = flySpeedSlider
    flySpeedButton.BackgroundTransparency = 0

    local flySpeedCorner = Instance.new("UICorner")
    flySpeedCorner.CornerRadius = UDim.new(1, 0)
    flySpeedCorner.Parent = flySpeedButton

    local isDraggingFlySpeed = false

    local function updateFlySpeedUI()
        local ratio = math.clamp(
            (FLY_CONFIG.flySpeed - FLY_CONFIG.minSpeed) / (FLY_CONFIG.maxSpeed - FLY_CONFIG.minSpeed),
            0,
            1
        )
        flySpeedFill.Size = UDim2.new(ratio, 0, 1, 0)
        flySpeedButton.Position = UDim2.new(ratio, -3.5, 0.5, -3.5)
        flySpeedTitle.Text = "Speed: " .. math.floor(FLY_CONFIG.flySpeed)
    end

    local function setFlySpeedFromX(x)
        local sliderAbsX = flySpeedSlider.AbsolutePosition.X
        local sliderWidth = flySpeedSlider.AbsoluteSize.X
        if sliderWidth <= 0 then return end
        local ratio = math.clamp((x - sliderAbsX) / sliderWidth, 0, 1)
        local newSpeed = FLY_CONFIG.minSpeed + ratio * (FLY_CONFIG.maxSpeed - FLY_CONFIG.minSpeed)
        newSpeed = math.floor(newSpeed + 0.5)
        FLY_CONFIG.flySpeed = math.clamp(newSpeed, FLY_CONFIG.minSpeed, FLY_CONFIG.maxSpeed)
        updateFlySpeedUI()
    end

    flySpeedButton.MouseButton1Down:Connect(function()
        isDraggingFlySpeed = true
    end)

    userInputService.InputChanged:Connect(function(input)
        if isDraggingFlySpeed and input.UserInputType == Enum.UserInputType.MouseMovement then
            setFlySpeedFromX(input.Position.X)
        end
    end)

    userInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            isDraggingFlySpeed = false
        end
    end)

    flyToggleBtn.MouseButton1Click:Connect(function()
        if flying then
            stopFly()
        else
            startFly()
        end
    end)

    local function onCharacterAdded(character)
        local shouldAutoEnable = flyWasActiveBeforeDeath
        flyWasActiveBeforeDeath = false

        local humanoid = character:WaitForChild("Humanoid", 5)
        local rootPart = character:WaitForChild("HumanoidRootPart", 5)

        if shouldAutoEnable and humanoid and rootPart then
            task.wait(0.5)
            if not flying then
                startFly()
            end
        end
    end

    local function onCharacterRemoving()
        flyWasActiveBeforeDeath = flying
        if flying then
            stopFly()
        end
    end

    player.CharacterAdded:Connect(onCharacterAdded)

    if player.Character then
        player.CharacterRemoving:Connect(onCharacterRemoving)
    end

    player.CharacterAdded:Connect(function(character)
        character.CharacterRemoving:Connect(onCharacterRemoving)
    end)

    userInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if not flying then return end

        if input.KeyCode == Enum.KeyCode.Space or input.KeyCode == Enum.KeyCode.ButtonA then
            jumpHeld = true
        end
    end)

    userInputService.InputEnded:Connect(function(input)
        if input.KeyCode == Enum.KeyCode.Space or input.KeyCode == Enum.KeyCode.ButtonA then
            jumpHeld = false
        end
    end)

    userInputService.JumpRequest:Connect(function()
        if not flying then return end
        lastJumpRequest = tick()
        jumpHeld = true
        task.spawn(function()
            task.wait(FLY_CONFIG.mobileJumpHoldTime)
            if tick() - lastJumpRequest >= FLY_CONFIG.mobileJumpHoldTime - 0.01 then
                jumpHeld = false
            end
        end)
    end)

    updateFlySpeedUI()
end

