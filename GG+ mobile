    local progressFill = Instance.new("Frame")
    progressFill.Size = UDim2.new(0, 0, 1, 0)
    progressFill.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
    progressFill.BorderSizePixel = 0
    progressFill.Parent = progressBar

    local text = "GG+"
    local startTime = tick()
    local duration = 5.0
    local animationComplete = false
    local line1Shown = false
    local line2Shown = false
    local tabIndex = 0
    local lastTabChange = 0
    local allTabsShown = false
    local allLoadedShown = false

    local connection

    connection = game:GetService("RunService").RenderStepped:Connect(function()
        local elapsed = tick() - startTime
        local progress = math.min(elapsed / duration, 1)

        progressFill.Size = UDim2.new(progress, 0, 1, 0)
        local percent = math.floor(progress * 100)
        timeLabel.Text = percent .. "%"

        if elapsed < 4.5 then
            if elapsed - lastTabChange > 0.34 then
                lastTabChange = elapsed
                tabIndex = tabIndex + 1
                if tabIndex <= #tabNames then
                    tabLabel.Text = tabNames[tabIndex]
                end
            end
        else
            if not allTabsShown then
                allTabsShown = true
                tabLabel.Text = "13.Forward"

                allLoadedLabel.Text = "All tabs loaded!"
                allLoadedLabel.TextTransparency = 1
                allLoadedShown = true
                spawn(function()
                    for i = 0, 1, 0.03 do
                        allLoadedLabel.TextTransparency = 1 - i
                        task.wait(0.02)
                    end
                end)
            end
        end

        local revealProgress = math.min(elapsed * 1.5, 1)
        local charsToShow = math.max(1, math.floor(revealProgress * #text))
        local displayText = string.sub(text, 1, charsToShow)

        if #displayText < #text then
            displayText = displayText .. string.rep("_", #text - #displayText)
        end

        textLabel.Text = displayText
        textLabel.TextScaled = true
        textLabel.TextSize = 0

        local dots = math.floor(elapsed * 2) % 4
        subtitle.Text = "Loading" .. string.rep(".", dots)

        if elapsed > 0.8 and not line1Shown then
            line1Shown = true
            spawn(function()
                for i = 0, 1, 0.05 do
                    line1Label.TextTransparency = 1 - i
                    task.wait(0.02)
                end
            end)
        end

        if line1Shown and not line2Shown and line1Label.TextTransparency < 0.1 then
            line2Shown = true
            spawn(function()
                task.wait(0.3)
                for i = 0, 1, 0.05 do
                    line2Label.TextTransparency = 1 - i
                    task.wait(0.02)
                end
            end)
        end

        if progress >= 1 and not animationComplete then
            animationComplete = true
            subtitle.Text = "READY!"
            timeLabel.Text = "100% - Complete!"
            if not allTabsShown then
                tabLabel.Text = "13.Forward"
            end

            if not allLoadedShown then
                allLoadedLabel.Text = "All tabs loaded!"
                allLoadedLabel.TextTransparency = 0
                allLoadedShown = true
            end

            task.wait(0.8)

            local fadeStart = tick()
            local fadeDuration = 0.8

            local fadeConnection = game:GetService("RunService").RenderStepped:Connect(function()
                local fadeProgress = (tick() - fadeStart) / fadeDuration

                if fadeProgress >= 1 then
                    loadingGui:Destroy()
                    fadeConnection:Disconnect()
                    connection:Disconnect()
                    print("Loading animation complete!")

                    task.wait(1)
                    print("✅ Panel is ready! Click GG+ button to open menu.")
                else
                    local transparency = fadeProgress
                    background.BackgroundTransparency = transparency
                    background2.BackgroundTransparency = transparency
                    textLabel.TextTransparency = transparency
                    subtitle.TextTransparency = transparency
                    timeLabel.TextTransparency = transparency
                    tabLabel.TextTransparency = transparency
                    allLoadedLabel.TextTransparency = transparency

                    local lineTransparency = 1 - (1 - transparency) * (1 - line1Label.TextTransparency)
                    line1Label.TextTransparency = math.min(lineTransparency, 1)
                    line2Label.TextTransparency = math.min(lineTransparency, 1)

                    progressBar.BackgroundTransparency = transparency
                    progressFill.BackgroundTransparency = transparency
                end
            end)
        end
    end)

    task.spawn(function()
        task.wait(6.5)
        if loadingGui and loadingGui.Parent then
            loadingGui:Destroy()
            if connection then connection:Disconnect() end
            print("Loading animation forcefully terminated (timeout)")
        end
    end)
end

