    локальный игрок = игра.Players.LocalPlayer
    если не игрок или не персонаж игрока, то
        print("❌ Игрок или персонаж не найден")
        return
    конец

    если не targetPlayer, то
        print("❌ Целевой игрок не найден")
        return
    конец

    local hrp = player.Character:FindFirstChild("HumanoidRootPart")
    если не ХРП, то
        print("❌ Нет HumanoidRootPart для игрока")
        return
    конец

    если не targetPlayer.Character, то
        targetPlayer:LoadCharacter()
        task.wait(1)
    конец

    локальные попытки = 0
    while attempts < 5 and not targetPlayer.Character do
        task.wait(0.5)
        попытки = попытки + 1
    конец

    если не targetPlayer.Character, то
        print("❌ Не удалось загрузить персонажа для " .. targetPlayer.Name)
        return
    конец

    local targetPos = nil

    local targetHrp = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
    если targetHrp то
        targetPos = targetHrp.Position + Vector3.new(0, 3, 0)
        print("✅ Найден HumanoidRootPart для " .. targetPlayer.Name)
    иначе
        локальные части = targetPlayer.Character:GetChildren()
        для _, часть в парах (частях) сделать
            если part:IsA("BasePart") тогда
                targetPos = part.Position + Vector3.new(0, 3, 0)
                print("✅ Найден фрагмент тела для " .. targetPlayer.Name)
                перерыв
            конец
        конец
    конец

    если targetPos, то
        hrp.CFrame = CFrame.new(targetPos)
        print("✅ Телепортирован в " .. targetPlayer.Name .. " в позиции " .. tostring(targetPos))
    иначе
