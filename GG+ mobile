-- ===== ВСПОМОГАТЕЛЬНЫЙ ИНСТРУКТОР ДЛЯ РУЧНОГО ВВОДА (ДОБАВЛЕН) =====
локальная функция AddManualInput(parentFrame, posX, posY, sizeX, sizeY, getValue, setValue, minVal, maxVal, labelText)
    local box = Instance.new("TextBox")
    box.Size = UDim2.new(sizeX, 0, sizeY, 0)
    box.Position = UDim2.new(posX, 0, posY, 0)
    box.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    box.BorderColor3 = Color3.fromRGB(0, 150, 255)
    box.BorderSizePixel = 1
    box.Text = tostring(math.floor(getValue()))
    box.TextColor3 = Color3.fromRGB(255, 255, 255)
    box.TextScaled = true
    box.Font = Enum.Font.SourceSans
    box.PlaceholderText = labelText or "Value"
    box.Parent = parentFrame

    local applyBtn = Instance.new("TextButton")
    applyBtn.Size = UDim2.new(0.18, 0, sizeY, 0)
    applyBtn.Position = UDim2.new(posX + sizeX + 0.01, 0, posY, 0)
    applyBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
    applyBtn.BorderColor3 = Color3.fromRGB(0, 200, 255)
    applyBtn.BorderSizePixel = 1
    applyBtn.Text = "OK"
    applyBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    applyBtn.TextScaled = true
    applyBtn.Font = Enum.Font.SourceSansBold
    applyBtn.Parent = parentFrame

    локальная функция apply()
        local num = tonumber(box.Text)
        если число, то
            -- Здесь нет ограничений: пользователь может задать любое значение.
            setValue(num)
            box.Text = tostring(math.floor(num))
        иначе
            box.Text = tostring(math.floor(getValue()))
        конец
    конец

    applyBtn.MouseButton1Click:Connect(apply)
    box.FocusLost:Connect(function(enterPressed)
        if enterPressed then apply() end
    конец)

    return box, applyBtn
конец

