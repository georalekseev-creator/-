                end
            end
        end

        for _, obj in pairs(workspace:GetDescendants()) do
            if obj:IsA("BillboardGui") and (obj.Name == "SpeedIndicator" or obj.Name == "SpeedDisplay") then
                obj:Destroy()
            end
        end
    end

    _G.SpeedIndicatorEnabled = true
    local SpeedIndicatorConnection = nil
    local SpeedIndicatorGui = nil
    local SpeedIndicatorLabel = nil
    local isSpeedIndicatorActive = false
    local respawnTimer = nil

    local lastPosition = nil
    local lastTime = tick()
    local smoothSpeed = 0
    local displaySpeed = 0
    local isMoving = false
    local stopTimer = 0
    local STOP_DELAY = 0.15

    local function ResetSpeedData()
        lastPosition = nil
        lastTime = tick()
        smoothSpeed = 0
        displaySpeed = 0
        isMoving = false
        stopTimer = 0

        if SpeedIndicatorLabel then
            SpeedIndicatorLabel.Text = "0 m/s"
            SpeedIndicatorLabel.TextColor3 = Color3.fromRGB(0, 200, 0)
            SpeedIndicatorLabel:SetAttribute("AnimStartTime", nil)
            SpeedIndicatorLabel:SetAttribute("StartColor", nil)
            SpeedIndicatorLabel:SetAttribute("TargetColor", nil)
            SpeedIndicatorLabel:SetAttribute("IsResetAnimation", nil)
        end

        if SpeedIndicatorGui then
            SpeedIndicatorGui.Enabled = true
        end
    end

    local function GetSpeedColor(speed)
        if speed <= 3 then
            return Color3.fromRGB(0, 200, 0)
        end

        local t = (speed - 3) / 147
        t = math.min(t, 1)
        t = t * t * (3 - 2 * t)

        local r = 0 + t * 255
        local g = 200 - t * 200
        local b = 0

        return Color3.fromRGB(
            math.floor(math.max(0, math.min(255, r))),
            math.floor(math.max(0, math.min(255, g))),
            math.floor(math.max(0, math.min(255, b)))
        )
    end

    local function ResetColorToGreenInstant()
        if SpeedIndicatorLabel then
            local greenColor = Color3.fromRGB(0, 200, 0)
            SpeedIndicatorLabel.TextColor3 = greenColor
            SpeedIndicatorLabel:SetAttribute("AnimStartTime", nil)
            SpeedIndicatorLabel:SetAttribute("StartColor", nil)
            SpeedIndicatorLabel:SetAttribute("TargetColor", nil)
            SpeedIndicatorLabel:SetAttribute("IsResetAnimation", nil)
        end
    end

    local function CreateSingleSpeedIndicator(char)
        if not char then return nil, nil end

        NukeAllSpeedIndicators()

        local gui = Instance.new("BillboardGui")
        gui.Name = "SpeedIndicator"
        gui.Size = UDim2.new(0, 40, 0, 12.5)
        gui.StudsOffset = Vector3.new(0, 1.75, 0)
        gui.AlwaysOnTop = true
        gui.MaxDistance = 50
        gui.Enabled = _G.SpeedIndicatorEnabled
        gui.Parent = char

        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1, 0, 1, 0)
        label.BackgroundTransparency = 1
        label.Text = "0 m/s"
        label.TextColor3 = Color3.fromRGB(0, 200, 0)
        label.TextScaled = true
        label.Font = Enum.Font.SourceSansBold
        label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        label.TextStrokeTransparency = 0.5
        label.Parent = gui

        SpeedIndicatorGui = gui
        SpeedIndicatorLabel = label

        ResetSpeedData()

        return gui, label
    end

    local function UpdateSpeedIndicator()
        if not _G.SpeedIndicatorEnabled then
            if SpeedIndicatorGui then
                SpeedIndicatorGui.Enabled = false
            end
            return
        end

        local player = game.Players.LocalPlayer
        if not player or not player.Character then
            if SpeedIndicatorGui then
                SpeedIndicatorGui.Enabled = false
            end
            return
        end

        local gui = player.Character:FindFirstChild("SpeedIndicator")
        if not gui then
            NukeAllSpeedIndicators()
            local newGui, newLabel = CreateSingleSpeedIndicator(player.Character)
            if newGui then
                SpeedIndicatorGui = newGui
                SpeedIndicatorLabel = newLabel
                ResetSpeedData()
            else
                return
            end
        else
            SpeedIndicatorGui = gui
            SpeedIndicatorLabel = gui:FindFirstChildWhichIsA("TextLabel")
        end

        local hrp = player.Character:FindFirstChild("HumanoidRootPart")
        if not hrp then
            if SpeedIndicatorGui then
                SpeedIndicatorGui.Enabled = false
            end
            return
        end

        local currentPos = hrp.Position
        local currentTime = tick()
        local deltaTime = currentTime - lastTime

        if deltaTime >= 0.05 then
            if lastPosition then
                local distance = (currentPos - lastPosition).Magnitude
                local speed = distance / deltaTime

                if speed > 0.5 then
                    isMoving = true
                    stopTimer = 0
                    smoothSpeed = smoothSpeed + (speed - smoothSpeed) * 0.15
                else
                    if isMoving then
                        isMoving = false
                        stopTimer = currentTime
                    end

                    if currentTime - stopTimer >= STOP_DELAY then
                        smoothSpeed = smoothSpeed - smoothSpeed * 0.6
                    else
                        smoothSpeed = smoothSpeed - smoothSpeed * 0.3
                    end
                end

                if smoothSpeed < 0.1 then
                    smoothSpeed = 0
                end

                if math.abs(smoothSpeed - displaySpeed) > 0.01 or smoothSpeed == 0 then
                    displaySpeed = smoothSpeed

                    local roundedSpeed = math.floor(displaySpeed * 10 + 0.5) / 10

                    if SpeedIndicatorGui then
                        SpeedIndicatorGui.Enabled = true
                    end

                    if SpeedIndicatorLabel then
                        local currentColor = SpeedIndicatorLabel.TextColor3
                        local isCurrentlyRed = currentColor.R > 100 and currentColor.G < 100

                        if displaySpeed < 150 and isCurrentlyRed then
                            ResetColorToGreenInstant()
                        end

                        local targetColor = GetSpeedColor(displaySpeed)

                        if not SpeedIndicatorLabel:GetAttribute("IsResetAnimation") then
                            if not SpeedIndicatorLabel:GetAttribute("AnimStartTime") then
                                SpeedIndicatorLabel:SetAttribute("AnimStartTime", tick())
                                SpeedIndicatorLabel:SetAttribute("StartColor", SpeedIndicatorLabel.TextColor3)
                                SpeedIndicatorLabel:SetAttribute("TargetColor", targetColor)
                            end

                            local currentTarget = SpeedIndicatorLabel:GetAttribute("TargetColor")
                            if currentTarget and (currentTarget.R ~= targetColor.R or
                               currentTarget.G ~= targetColor.G or
                               currentTarget.B ~= targetColor.B) then
                                SpeedIndicatorLabel:SetAttribute("AnimStartTime", tick())
                                SpeedIndicatorLabel:SetAttribute("StartColor", SpeedIndicatorLabel.TextColor3)
                                SpeedIndicatorLabel:SetAttribute("TargetColor", targetColor)
                            end

                            local animStart = SpeedIndicatorLabel:GetAttribute("AnimStartTime") or tick()
                            local elapsed = tick() - animStart
                            local duration = 1.0
                            local progress = math.min(elapsed / duration, 1)

                            local eased = progress < 0.5 and (2 * progress * progress) or (1 - math.pow(-2 * progress + 2, 2) / 2)

                            local startColor = SpeedIndicatorLabel:GetAttribute("StartColor") or Color3.fromRGB(0, 200, 0)
                            local targetColorAttr = SpeedIndicatorLabel:GetAttribute("TargetColor") or targetColor
                            local currentColorAnimated = Color3.new(
                                startColor.R + (targetColorAttr.R - startColor.R) * eased,
                                startColor.G + (targetColorAttr.G - startColor.G) * eased,
                                startColor.B + (targetColorAttr.B - startColor.B) * eased
                            )

                            SpeedIndicatorLabel.TextColor3 = currentColorAnimated

                            if progress >= 1 then
                                SpeedIndicatorLabel:SetAttribute("AnimStartTime", nil)
                                SpeedIndicatorLabel:SetAttribute("StartColor", nil)
                                SpeedIndicatorLabel:SetAttribute("TargetColor", nil)
                            end
                        end

                        if displaySpeed < 0.3 then
                            SpeedIndicatorLabel.Text = "0 m/s"
                        else
                            SpeedIndicatorLabel.Text = tostring(roundedSpeed) .. " m/s"
                        end
                    end
                end
            end

            lastPosition = currentPos
            lastTime = currentTime
        end
    end

    local function StartSpeedIndicator()
        if SpeedIndicatorConnection then
            SpeedIndicatorConnection:Disconnect()
            SpeedIndicatorConnection = nil
        end

        isSpeedIndicatorActive = true

        NukeAllSpeedIndicators()
        ResetSpeedData()

        local player = game.Players.LocalPlayer
        if player and player.Character then
            local gui, label = CreateSingleSpeedIndicator(player.Character)
            if gui then
                SpeedIndicatorGui = gui
                SpeedIndicatorLabel = label
                gui.Enabled = _G.SpeedIndicatorEnabled
