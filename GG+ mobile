локальная функция SetupMenuDrag()
    local isDraggingPanel = false
    local dragStartPanel = nil
    local startPosPanel = nil
    local dragTarget = nil

    локальная функция CanStartDrag(input)
        если input.UserInputType ~= Enum.UserInputType.MouseButton1, то
            return false
        конец

        local mouse = game.Players.LocalPlayer:GetMouse()
        Если мышь не используется, то вернуть false.

        локальная цель = mouse.Target
        Если цель не достигнута, то вернуть false.

        локальный ток = цель
        пока current и current ~= MenuPanel делают
            если current:IsA("TextButton") или current:IsA("ImageButton"), то
                если текущий == TitleFrame или текущий: IsDescendantOf(TitleFrame), то
                    вернуть true
                конец
                return false
            конец

            если current:IsA("ScrollingFrame") or current:IsA("TextBox") or current:IsA("Slider") then
                return false
            конец

            Если current:IsA("Frame") и current.Name == "ScrollingFrame", то
                return false
            конец

            current = current.Parent
        конец

        вернуть true
    конец

    MenuPanel.InputBegan:Connect(function(input)
        если input.UserInputType == Enum.UserInputType.MouseButton1, то
            Если CanStartDrag(input), то
                isDraggingPanel = true
                dragStartPanel = input.Position
                startPosPanel = MenuPanel.Position
                dragTarget = MenuPanel
                input.StopPropagation = true
            конец
        конец
    конец)

    game:GetService("UserInputService").InputChanged:Connect(function(input)
        Если isDraggingPanel и input.UserInputType == Enum.UserInputType.MouseMovement и dragTarget, то
            local delta = input.Position - dragStartPanel
            MenuPanel.Position = UDim2.new(
                startPosPanel.X.Scale,
                startPosPanel.X.Offset + delta.X,
                startPosPanel.Y.Scale,
                startPosPanel.Y.Offset + delta.Y
