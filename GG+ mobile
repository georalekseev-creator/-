-- ===== DRAG SYSTEM FOR MAIN BUTTON (GG+) =====
local function SetupMainButtonDrag()
    local dragging = false
    local dragStart = nil
    local startPos = nil
    local isDraggingButton = false

    MainButton.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            isDraggingButton = true
            dragStart = input.Position
            startPos = MainButton.Position
            input.StopPropagation = true
        end
    end)

    MainButton.InputChanged:Connect(function(input)
        if dragging and isDraggingButton and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - dragStart
            MainButton.Position = UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )
        end
    end)

    MainButton.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
            isDraggingButton = false
        end
    end)
end

