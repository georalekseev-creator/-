            local humanoid = character:FindFirstChild("Humanoid")

            if not hrp or not humanoid then task.wait(0.1); continue end

            Если IsStopped, то
                если StopPosition, то
                    если не StopBodyPosition, то
                        local bodyPos, bodyGyro = CreateHoldPosition(hrp, StopPosition)
                        StopBodyPosition = bodyPos
                        если bodyGyro, то
                            если не StopBodyPosition:FindFirstChild("StopGyro"), то
                                bodyGyro.Name = "StopGyro"
                                bodyGyro.Parent = StopBodyPosition
                            конец
                        конец
                    конец
                конец

                Если tick() - StopStartTime >= STOP_DURATION, то
                    IsStopped = false
                    RemoveHold()

                    если CurrentWalkIndex == #WalkPointsData тогда
                        RemoveHold()
                        WaitingAtEnd = true
                        WaitStartTime = tick()
                        WalkStatus.Text = "Достигнута последняя точка! Ожидание " .. PAUSE_AT_END .. " сек..."
                        WalkStatus.TextColor3 = Library.Theme.Warning
                    иначе
                        CurrentWalkIndex = CurrentWalkIndex + 1
                        if CurrentWalkIndex > #WalkPointsData then CurrentWalkIndex = 1 end
                        local nextData = WalkPointsData[CurrentWalkIndex]
                        если nextData тогда
                            WalkStatus.Text = "Walking to " .. nextData.name .. " (" .. CurrentWalkIndex .. "/" .. #WalkPointsData .. ")"
                            WalkStatus.TextColor3 = Library.Theme.WalkActive
                        конец
                    конец
                конец
                task.wait(0.05)
                продолжить
            конец

            Если WaitingAtEnd, то
                local timeLeft = math.floor(PAUSE_AT_END - (tick() - WaitStartTime))
                если timeLeft > 0, то
                    WalkStatus.Text = "Ожидание " .. оставшееся время .. " сек... (можно двигаться)"
                    WalkStatus.TextColor3 = Library.Theme.Warning
                иначе
                    WaitingAtEnd = false
                    WaitForTeleport = true
                    TeleportWaitStart = tick()
                    if NoclipEnabled then SetNoclip(false) end
                конец
                task.wait(0.1)
                продолжить
            конец

            Если WaitForTeleport, то
                if tick() - TeleportWaitStart >= 0.5 then
                    WaitForTeleport = false

                    CurrentWalkIndex = 1
                    локальные firstData = WalkPointsData[1]
                    если firstData тогда
                        TeleportToPosition(firstData.pos)
                        WalkStatus.Text = "Иду к " .. firstData.name
                        WalkStatus.TextColor3 = Library.Theme.WalkActive

                        IsStopped = true
                        StopStartTime = tick()
                        StopPosition = firstData.pos

                        local bodyPos, bodyGyro = CreateHoldPosition(hrp, StopPosition)
                        StopBodyPosition = bodyPos
                        если bodyGyro, то
                            bodyGyro.Name = "StopGyro"
                            bodyGyro.Parent = bodyPos
                        конец

                        WalkStatus.Text = "Остановка в " .. firstData.name .. " (" .. STOP_DURATION .. " сек)"
                        WalkStatus.TextColor3 = Library.Theme.Warning
                    конец

                    if not NoclipEnabled then SetNoclip(true) end
                иначе
                    WalkStatus.Text = "Телепортация через " .. string.format("%.1f", 0.5 - (tick() - TeleportWaitStart)) .. " сек..."
                    WalkStatus.TextColor3 = Library.Theme.Warning
                конец
                task.wait(0.05)
                продолжить
            конец

            if CurrentWalkIndex > #WalkPointsData then CurrentWalkIndex = 1 end

            local targetData = WalkPointsData[CurrentWalkIndex]
            if not targetData then targetData = WalkPointsData[1] end

            local targetPos = targetData.pos
            локальное расстояние = (targetPos - hrp.Position).Magnitude

            локальный REACH_DISTANCE = 3

            если расстояние > REACH_DISTANCE, то
                локальная скорость = math.min(WalkSpeed, MAX_WALK_SPEED)
                humanoid.WalkSpeed ​​= скорость

                локальное направление = (targetPos - hrp.Position).Unit

                локальная целевая скорость = направление * скорость
                SmoothVelocity = SmoothVelocity + (targetVelocity - SmoothVelocity) * SMOOTH_FACTOR

                hrp.Velocity = SmoothVelocity

                Если direction.Magnitude > 0.1, то
                    local targetCFrame = CFrame.lookAt(hrp.Position, hrp.Position + direction)
                    hrp.CFrame = hrp.CFrame:Lerp(targetCFrame, 0.3)
                конец

                WalkStatus.Text = "Walking to " .. targetData.name .. " (" .. CurrentWalkIndex .. "/" .. #WalkPointsData .. ")"
                WalkStatus.TextColor3 = Library.Theme.WalkActive
            иначе
                local isLastPoint = (CurrentWalkIndex == #WalkPointsData)
                если isLastPoint, то
                    hrp.Velocity = Vector3.new(0, 0, 0)
                    SmoothVelocity = Vector3.new(0, 0, 0)
                    humanoid.WalkSpeed ​​= 0

                    IsStopped = false
                    RemoveHold()

                    WaitingAtEnd = true
                    WaitStartTime = tick()
                    WalkStatus.Text = "Достигнута последняя точка! Ожидание " .. PAUSE_AT_END .. " сек..."
                    WalkStatus.TextColor3 = Library.Theme.Warning
                иначе
                    hrp.Velocity = Vector3.new(0, 0, 0)
                    SmoothVelocity = Vector3.new(0, 0, 0)
                    humanoid.WalkSpeed ​​= 0

                    StopPosition = targetPos

                    local bodyPos, bodyGyro = CreateHoldPosition(hrp, StopPosition)
                    StopBodyPosition = bodyPos
                    если bodyGyro, то
                        bodyGyro.Name = "StopGyro"
                        bodyGyro.Parent = bodyPos
                    конец

                    IsStopped = true
                    StopStartTime = tick()

                    WalkStatus.Text = "Остановка в " .. targetData.name .. " (" .. STOP_DURATION .. " сек)"
                    WalkStatus.TextColor3 = Library.Theme.Warning
                конец
            конец

            task.wait(0.03)
        конец

        StopWalking()
    конец)
