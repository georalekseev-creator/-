                if math.abs(dy) > MAX_D then dy = (dy > 0 and MAX_D or -MAX_D) end

                FC.cameraRotation = FC.cameraRotation * CFrame.Angles(0, dx, 0) * CFrame.Angles(dy, 0, 0)
                local look = FC.cameraRotation.LookVector
