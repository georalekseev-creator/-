                {speed = 3, color = Color3.fromRGB(0, 200, 255)},
                {speed = 8, color = Color3.fromRGB(0, 255, 100)},
                {speed = 18, color = Color3.fromRGB(255, 200, 0)},
                {speed = 35, color = Color3.fromRGB(255, 150, 0)},
                {speed = 60, color = Color3.fromRGB(255, 50, 50)},
                {speed = 100, color = Color3.fromRGB(255, 0, 0)},
            }
            
            if speed <= colors[1].speed then return colors[1].color end
            if speed >= colors[#colors].speed then return colors[#colors].color end
            
            for i = 1, #colors - 1 do
                local low = colors[i]
                local high = colors[i + 1]
                if speed >= low.speed and speed <= high.speed then
                    local t = (speed - low.speed) / (high.speed - low.speed)
                    t = t * t * (3 - 2 * t)
                    return Color3.new(
                        low.color.R + (high.color.R - low.color.R) * t,
                        low.color.G + (high.color.G - low.color.G) * t,
                        low.color.B + (high.color.B - low.color.B) * t
                    )
                end
            end
            return colors[1].color
        end
    end

    local function CreateSingleSpeedIndicator(char)
        if not char then return nil, nil end

        NukeAllSpeedIndicators()

        local gui = Instance.new("BillboardGui")
        gui.Name = "SpeedIndicator"
