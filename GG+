local XRayTab = Tabs[8]

local XRayActive = false
local XRayTransparency = 50

local function IsWorldPart(part)
    if not part or not part.Parent then return false end

    if part:IsDescendantOf(game.CoreGui) then return false end
    if part:IsDescendantOf(game.StarterGui) then return false end

    local player = game.Players.LocalPlayer
    if player and player.Character and part:IsDescendantOf(player.Character) then return false end

    for _, p in pairs(game.Players:GetPlayers()) do
        if p.Character and part:IsDescendantOf(p.Character) then return false end
    end

    return true
end

local XRayParts = {}
local XRayOriginalTransparencies = {}

local function UpdateXRay()
    if XRayActive then
        local targetTransparency = XRayTransparency / 100

        for _, part in pairs(workspace:GetDescendants()) do
            if part:IsA("BasePart") and IsWorldPart(part) then
                if not XRayOriginalTransparencies[part] then
                    XRayOriginalTransparencies[part] = part.Transparency
                    table.insert(XRayParts, part)
                end
                part.Transparency = targetTransparency
            end
        end
    else
        for part, origTrans in pairs(XRayOriginalTransparencies) do
            if part and part.Parent then
                part.Transparency = origTrans
            end
        end
        XRayOriginalTransparencies = {}
        XRayParts = {}
    end
end

local function CleanXRayData()
    for part in pairs(XRayOriginalTransparencies) do
        if not part or not part.Parent then
            XRayOriginalTransparencies[part] = nil
        end
    end

    XRayParts = {}
    for part in pairs(XRayOriginalTransparencies) do
        table.insert(XRayParts, part)
    end
end

