<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes" />
    <title>GG+ — Оплата через сайт банка</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', 'Gotham', system-ui, -apple-system, sans-serif;
        }

        body {
            min-height: 100vh;
            background: #000000;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 1rem;
        }

        .card {
            background: rgba(20, 20, 20, 0.95);
            backdrop-filter: blur(4px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 40px;
            padding: 2.2rem 1.8rem;
            max-width: 680px;
            width: 100%;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.9), 0 0 0 1px rgba(255, 255, 255, 0.03);
            transition: all 0.25s ease;
        }

        .generator-section {
            display: block;
            transition: opacity 0.3s ease;
        }

        .generator-section.hidden {
            display: none;
        }

        .header {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            margin-bottom: 0.5rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.06);
            padding-bottom: 0.75rem;
        }

        .header h1 {
            font-size: 1.9rem;
            font-weight: 700;
            color: #ffffff;
            letter-spacing: 0.3px;
            text-shadow: 0 2px 0 rgba(0, 0, 0, 0.5);
        }

        .header span {
            font-size: 2rem;
            line-height: 1;
        }

        .subhead {
            color: #888888;
            font-size: 0.95rem;
            margin-bottom: 1.8rem;
            padding-left: 0.2rem;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap;
        }

        .badge {
            background: #1a1a1a;
            border-radius: 40px;
            padding: 0.2rem 0.9rem;
            font-size: 0.75rem;
            color: #aaaaaa;
            border: 1px solid #2a2a2a;
        }

        .input-group {
            display: flex;
            flex-direction: column;
            gap: 1rem;
            margin-top: 0.5rem;
        }

        .input-row {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 0.75rem;
            position: relative;
        }

        .input-row label {
            color: #aaaaaa;
            font-weight: 600;
            font-size: 1rem;
            min-width: 40px;
            position: relative;
            z-index: 1;
        }

        .input-row input {
            flex: 1;
            min-width: 180px;
            padding: 0.8rem 1.2rem;
            border-radius: 40px;
            border: 1px solid #2a2a2a;
            background: #0a0a0a;
            color: #f0f0f0;
            font-size: 1rem;
            font-weight: 500;
            outline: none;
            transition: 0.2s;
            box-shadow: inset 0 2px 6px rgba(0,0,0,0.8);
            transform: perspective(500px) rotateX(0deg);
            transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
            position: relative;
            z-index: 1;
        }

        .input-row input:hover {
            transform: perspective(500px) rotateX(2deg) scale(1.01);
            border-color: #555555;
            box-shadow: inset 0 2px 6px rgba(0,0,0,0.8), 0 4px 15px rgba(255,255,255,0.03);
        }

        .input-row input:focus {
            border-color: #777777;
            background: #111111;
            box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.05), inset 0 2px 6px rgba(0,0,0,0.8);
            transform: perspective(500px) rotateX(0deg);
        }

        .input-row input::placeholder {
            color: #444444;
            font-weight: 400;
        }

        .btn-buy-wrapper {
            display: flex;
            justify-content: center;
            margin: 0.5rem 0 1rem 0;
            position: relative;
        }

        .btn-buy {
            background: linear-gradient(135deg, #ffffff, #e8e8e8);
            border: none;
            border-radius: 60px;
            padding: 1rem 3.5rem;
            font-weight: 800;
            font-size: 1.4rem;
            color: #000000;
            cursor: pointer;
            transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
            box-shadow: 0 8px 0 #888888, 0 8px 30px rgba(0,0,0,0.6);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 14px;
            letter-spacing: 1px;
            border: 2px solid #dddddd;
            text-transform: uppercase;
            position: relative;
            width: 100%;
            max-width: 400px;
            transform: perspective(600px) rotateX(0deg) translateZ(0);
            transform-style: preserve-3d;
            overflow: hidden;
            z-index: 1;
        }

        .btn-buy::before {
            content: '';
            position: absolute;
            top: -2px;
            left: -2px;
            right: -2px;
            bottom: -2px;
            border-radius: 62px;
            background: linear-gradient(135deg, #ffffff, #aaaaaa, #ffffff);
            z-index: -1;
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .btn-buy:hover {
            background: linear-gradient(135deg, #ffffff, #f5f5f5);
            transform: perspective(600px) rotateX(4deg) translateZ(8px) scale(1.02);
            box-shadow: 0 10px 0 #777777, 0 12px 40px rgba(255,255,255,0.1);
            border-color: #ffffff;
        }

        .btn-buy:hover::before {
            opacity: 1;
        }

        .btn-buy:active {
            transform: perspective(600px) rotateX(2deg) translateZ(-4px) scale(0.98);
            box-shadow: 0 4px 0 #888888, 0 4px 20px rgba(0,0,0,0.6);
            transition-duration: 0.08s;
        }

        .btn-buy .icon {
            font-size: 1.6rem;
        }

        .tariff-selector {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
            gap: 0.7rem;
            margin: 1rem 0 1.2rem 0;
        }

        .tariff-btn {
            background: #0a0a0a;
            border: 1px solid #2a2a2a;
            border-radius: 16px;
            padding: 0.7rem 0.5rem;
            color: #aaaaaa;
            cursor: pointer;
            transition: all 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
            text-align: center;
            font-size: 0.85rem;
            font-weight: 500;
            min-height: 60px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            gap: 2px;
            transform: perspective(400px) rotateX(0deg) translateZ(0);
            transform-style: preserve-3d;
            position: relative;
            overflow: hidden;
        }

        .tariff-btn:hover {
            border-color: #666666;
            background: #161616;
            transform: perspective(400px) rotateX(3deg) translateZ(6px) scale(1.03);
            box-shadow: 0 6px 20px rgba(255,255,255,0.03);
        }

        .tariff-btn:active {
            transform: perspective(400px) rotateX(1deg) translateZ(-2px) scale(0.97);
            transition-duration: 0.08s;
        }

        .tariff-btn.active {
            border-color: #ffffff;
            background: #1a1a1a;
            color: #ffffff;
            box-shadow: 0 0 30px rgba(255, 255, 255, 0.04);
            transform: perspective(400px) rotateX(0deg) translateZ(0);
        }

        .tariff-btn .price {
            font-size: 1.1rem;
            font-weight: 700;
            color: #ffffff;
            position: relative;
            z-index: 1;
        }

        .tariff-btn .period {
            font-size: 0.7rem;
            color: #666666;
            position: relative;
            z-index: 1;
        }

        .tariff-btn.active .period {
            color: #888888;
        }

        .bank-section {
            display: none;
            transition: opacity 0.3s ease;
        }

        .bank-section.active {
            display: block;
        }

        .bank-section .subhead {
            margin-bottom: 1rem;
        }

        .app-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
            gap: 1rem;
            margin: 1.2rem 0 0.5rem;
        }

        .app-card {
            background: #0a0a0a;
            border-radius: 28px;
            padding: 1.2rem 0.5rem 1rem;
            border: 1px solid #1a1a1a;
            transition: all 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
            cursor: default;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            box-shadow: inset 0 2px 6px rgba(0,0,0,0.6);
            color: #aaaaaa;
            text-decoration: none;
            gap: 8px;
            min-height: 140px;
            transform: perspective(400px) rotateX(0deg) translateZ(0);
            transform-style: preserve-3d;
            position: relative;
            overflow: hidden;
        }

        .app-card:hover {
            border-color: #555555;
            background: #141414;
            transform: perspective(400px) rotateX(4deg) translateZ(10px) scale(1.03);
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(255, 255, 255, 0.04);
        }

        .app-card:active {
            transform: perspective(400px) rotateX(2deg) translateZ(-2px) scale(0.97);
            transition-duration: 0.08s;
            box-shadow: inset 0 4px 8px rgba(0,0,0,0.8);
        }

        .app-logo {
            width: 60px;
            height: 60px;
            border-radius: 16px;
            object-fit: contain;
            background: #1a1a1a;
            padding: 6px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.5);
            transition: transform 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            font-size: 1.2rem;
            color: #ffffff;
            position: relative;
            z-index: 1;
        }

        .app-card:hover .app-logo {
            transform: scale(1.08) rotateX(2deg);
        }

        .app-name {
            font-weight: 600;
            font-size: 0.9rem;
            color: #dddddd;
            letter-spacing: 0.3px;
            margin-top: 2px;
            position: relative;
            z-index: 1;
        }

        .app-desc {
            font-size: 0.65rem;
            color: #555555;
            font-weight: 400;
            margin-top: -2px;
            position: relative;
            z-index: 1;
        }

        .bank-highlight {
            border-color: #ffffff;
            background: #1a1a1a;
        }

        .bank-highlight .app-name {
            color: #ffffff;
        }

        .bank-highlight:hover {
            border-color: #ffffff;
            background: #222222;
        }

        .action-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 1.8rem;
            flex-wrap: wrap;
            gap: 0.8rem;
        }

        .back-link {
            color: #666666;
            text-decoration: none;
            font-size: 0.9rem;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            border-bottom: 1px dashed #333333;
            padding-bottom: 2px;
            transition: all 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
            cursor: pointer;
            transform: perspective(300px) rotateX(0deg);
            position: relative;
        }

        .back-link:hover {
            color: #aaaaaa;
            border-bottom-color: #555555;
            transform: perspective(300px) rotateX(2deg) translateZ(4px);
        }

        .back-link:active {
            transform: perspective(300px) rotateX(0deg) translateZ(-2px);
        }

        .info-note {
            font-size: 0.8rem;
            color: #444444;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .info-note strong {
            color: #888888;
        }

        .footer-note {
            margin-top: 1.8rem;
            text-align: center;
            color: #333333;
            font-size: 0.75rem;
            border-top: 1px solid #1a1a1a;
            padding-top: 1.2rem;
            letter-spacing: 0.3px;
        }

        .footer-note span {
            color: #555555;
        }

        .status {
            margin-top: 1rem;
            padding: 0.6rem 1rem;
            border-radius: 40px;
            background: #0a0a0a;
            color: #aaaaaa;
            font-size: 0.9rem;
            border-left: 4px solid #444444;
            display: flex;
            align-items: center;
            gap: 10px;
            transition: all 0.2s ease;
            min-height: 3rem;
            transform: perspective(300px) rotateX(0deg);
            position: relative;
        }

        .status:hover {
            transform: perspective(300px) rotateX(1deg);
        }

        .status .emoji {
            font-size: 1.3rem;
            position: relative;
            z-index: 1;
        }

        .status span:last-child {
            position: relative;
            z-index: 1;
        }

        .warning-box {
            background: #1a0a0a;
            border: 1px solid #884444;
            border-radius: 20px;
            padding: 1.2rem 1.5rem;
            margin: 1rem 0 1.5rem 0;
            color: #dd8888;
            font-size: 0.95rem;
            line-height: 1.5;
            text-align: center;
            transition: all 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
            transform: perspective(300px) rotateX(0deg);
            position: relative;
        }

        .warning-box:hover {
            transform: perspective(300px) rotateX(2deg) translateZ(4px);
            border-color: #aa5555;
        }

        .warning-box strong {
            color: #ff6666;
            display: block;
            font-size: 1.1rem;
            margin-bottom: 0.3rem;
            position: relative;
            z-index: 1;
        }

        .warning-box span {
            position: relative;
            z-index: 1;
        }

        .warning-box .highlight {
            color: #ffffff;
            background: #2a1a1a;
            padding: 0.2rem 0.8rem;
            border-radius: 20px;
            font-weight: 700;
            display: inline-block;
            margin-top: 0.3rem;
            border: 1px solid #884444;
            position: relative;
            z-index: 1;
        }

        .selected-tariff-info {
            color: #888888;
            font-size: 0.9rem;
            text-align: center;
            padding: 0.5rem;
            border-top: 1px solid #1a1a1a;
            margin-top: 0.5rem;
            position: relative;
        }

        .selected-tariff-info strong {
            color: #ffffff;
            position: relative;
            z-index: 1;
        }

        @media (max-width: 480px) {
            .card { padding: 1.5rem 1rem; }
            .header h1 { font-size: 1.5rem; }
            .app-grid { grid-template-columns: repeat(3, 1fr); gap: 0.7rem; }
            .app-card { padding: 0.9rem 0.2rem; min-height: 120px; }
            .app-logo { width: 50px; height: 50px; font-size: 1rem; }
            .app-name { font-size: 0.75rem; }
            .app-desc { font-size: 0.55rem; }
            .input-row { flex-direction: column; align-items: stretch; }
            .btn-buy { padding: 0.8rem 2rem; font-size: 1.1rem; max-width: 100%; }
            .btn-buy-wrapper { margin: 0.3rem 0 0.8rem 0; }
            .warning-box { font-size: 0.85rem; padding: 1rem; }
            .tariff-selector { grid-template-columns: repeat(3, 1fr); }
            .tariff-btn { font-size: 0.75rem; min-height: 50px; padding: 0.5rem 0.3rem; }
            .tariff-btn .price { font-size: 0.95rem; }
        }

        @media (max-width: 380px) {
            .app-grid { grid-template-columns: repeat(2, 1fr); }
            .tariff-selector { grid-template-columns: repeat(2, 1fr); }
        }
    </style>
</head>
<body>
    <div class="card" id="app">
        <!-- ====== ПЕРВЫЙ ЭКРАН: ГЕНЕРАТОР + КНОПКА КУПИТЬ ====== -->
        <div class="generator-section" id="generatorSection">
            <div class="header">
                <span>🔐</span>
                <h1>Активация GG+</h1>
            </div>
            <div class="subhead">
                <span>Введите ваш ID и выберите тариф</span>
                <span class="badge">🔑 привязка к ID</span>
            </div>

            <div class="btn-buy-wrapper">
                <button class="btn-buy" id="buyBtn">
                    <span class="icon">💰</span>
                    КУПИТЬ
                </button>
            </div>

            <div class="warning-box">
                <strong>⚠️ ВАЖНО!</strong>
                <span>Зайдите в скрипт — там будет ваш ID.<br/>
                <span style="color: #aa6666;">Это самое важное!</span><br/>
                <span style="color: #888888; font-size: 0.85rem;">
                    Введите свой ID, иначе ключ не подойдёт и деньги на воздух.<br/>
                    <span class="highlight">Каждый ID — индивидуальный!</span>
                </span>
            </div>

            <div class="tariff-selector" id="tariffSelector">
                <button class="tariff-btn active" data-price="50" data-months="1">
                    <span class="price">50 ₽</span>
                    <span class="period">1 месяц</span>
                </button>
                <button class="tariff-btn" data-price="100" data-months="2">
                    <span class="price">100 ₽</span>
                    <span class="period">2 месяца</span>
                </button>
                <button class="tariff-btn" data-price="150" data-months="3">
                    <span class="price">150 ₽</span>
                    <span class="period">3 месяца</span>
                </button>
                <button class="tariff-btn" data-price="200" data-months="4">
                    <span class="price">200 ₽</span>
                    <span class="period">4 месяца</span>
                </button>
                <button class="tariff-btn" data-price="250" data-months="5">
                    <span class="price">250 ₽</span>
                    <span class="period">5 месяцев</span>
                </button>
                <button class="tariff-btn" data-price="300" data-months="6">
                    <span class="price">300 ₽</span>
                    <span class="period">6 месяцев</span>
                </button>
                <button class="tariff-btn" data-price="350" data-months="7">
                    <span class="price">350 ₽</span>
                    <span class="period">7 месяцев</span>
                </button>
                <button class="tariff-btn" data-price="400" data-months="8">
                    <span class="price">400 ₽</span>
                    <span class="period">8 месяцев</span>
                </button>
                <button class="tariff-btn" data-price="450" data-months="9">
                    <span class="price">450 ₽</span>
                    <span class="period">9 месяцев</span>
                </button>
                <button class="tariff-btn" data-price="500" data-months="10">
                    <span class="price">500 ₽</span>
                    <span class="period">10 месяцев</span>
                </button>
                <button class="tariff-btn" data-price="550" data-months="11">
                    <span class="price">550 ₽</span>
                    <span class="period">11 месяцев</span>
                </button>
                <button class="tariff-btn" data-price="600" data-months="12">
                    <span class="price">600 ₽</span>
                    <span class="period">12 месяцев</span>
                </button>
            </div>

            <div class="input-group">
                <div class="input-row">
                    <label for="playerIdInput">ID</label>
                    <input type="number" id="playerIdInput" placeholder="Ваш ID из скрипта" value="" min="1" step="1" />
                </div>
            </div>

            <div class="selected-tariff-info">
                Выбран тариф: <strong id="tariffDisplay">50 ₽ — 1 месяц</strong>
            </div>

            <div class="status" id="statusMessage">
                <span class="emoji">💡</span>
                <span id="statusText">Введите ID из скрипта и нажмите «Купить»</span>
            </div>

            <div class="footer-note">
                <span>🔹 После нажатия «Купить» выберите сайт банка для оплаты</span>
            </div>
        </div>

        <!-- ====== ВТОРОЙ ЭКРАН: ВЫБОР БАНКА ====== -->
        <div class="bank-section" id="bankSection">
            <div class="header">
                <span>💳</span>
                <h1>Оплата GG+</h1>
            </div>
            <div class="subhead">
                <span>Выберите официальный сайт банка для оплаты</span>
                <span class="badge">🔐 защищено</span>
            </div>

            <div class="app-grid" id="appGrid">
                <div class="app-card bank-highlight">
                    <div class="app-logo" style="background:#1a4a7a;color:#fff;">СБЕР</div>
