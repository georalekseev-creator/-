                <div class="app-card">
                    <div class="app-logo" style="background:#e3000f;color:#fff;">Р</div>
                    <div class="app-name">Райффайзен</div>
                    <div class="app-desc">Официальный сайт</div>
                </div>

                <div class="app-card">
                    <div class="app-logo" style="background:#003580;color:#fff;">ПБ</div>
                    <div class="app-name">Почта Банк</div>
                    <div class="app-desc">Официальный сайт</div>
                </div>

                <div class="app-card">
                    <div class="app-logo" style="background:#004d7a;color:#fff;">ОТП</div>
                    <div class="app-name">ОТП Банк</div>
                    <div class="app-desc">Официальный сайт</div>
                </div>

                <div class="app-card">
                    <div class="app-logo" style="background:#e30613;color:#fff;">МТС</div>
                    <div class="app-name">МТС Банк</div>
                    <div class="app-desc">Официальный сайт</div>
                </div>

                <div class="app-card">
                    <div class="app-logo" style="background:#f5c842;color:#000;">Ю</div>
                    <div class="app-name">ЮMoney</div>
                    <div class="app-desc">Официальный сайт</div>
                </div>

                <div class="app-card">
                    <div class="app-logo" style="background:#ff8c00;color:#fff;">QIWI</div>
                    <div class="app-name">Qiwi</div>
                    <div class="app-desc">Официальный сайт</div>
                </div>

                <div class="app-card">
                    <div class="app-logo" style="background:#003d7a;color:#fff;">СБП</div>
                    <div class="app-name">СБП</div>
                    <div class="app-desc">Официальный сайт</div>
                </div>
            </div>

            <div class="action-row">
                <span class="back-link" id="backToGenerator">← Вернуться к выбору тарифа</span>
                <span class="info-note">
                    <span>🔹</span> <strong id="bankPriceDisplay">Сумма: 50 ₽</strong>
                </span>
            </div>

            <div class="footer-note">
                <span>При нажатии на банк вы будете перенаправлены на его официальный сайт.</span><br/>
                <span style="color: #333333; font-size: 0.7rem;">Все сайты защищены SSL-сертификатами</span>
            </div>
        </div>
    </div>

    <script>
        (function() {
            "use strict";

            const generatorSection = document.getElementById('generatorSection');
            const bankSection = document.getElementById('bankSection');
            const buyBtn = document.getElementById('buyBtn');
            const playerIdInput = document.getElementById('playerIdInput');
            const statusText = document.getElementById('statusText');
            const statusEmoji = document.querySelector('#statusMessage .emoji');
            const backLink = document.getElementById('backToGenerator');
            const appCards = document.querySelectorAll('.app-card');
            const tariffBtns = document.querySelectorAll('.tariff-btn');
            const tariffDisplay = document.getElementById('tariffDisplay');
            const bankPriceDisplay = document.getElementById('bankPriceDisplay');

            let selectedPrice = 50;
            let selectedMonths = 1;
            let savedId = '';

            // ---- Выбор тарифа ----
            tariffBtns.forEach(btn => {
                btn.addEventListener('click', function() {
                    tariffBtns.forEach(b => b.classList.remove('active'));
                    this.classList.add('active');
                    selectedPrice = parseInt(this.dataset.price);
                    selectedMonths = parseInt(this.dataset.months);
                    const monthText = getMonthText(selectedMonths);
                    tariffDisplay.textContent = `${selectedPrice} ₽ — ${selectedMonths} ${monthText}`;
                    setStatus('💡', `Выбран тариф: ${selectedPrice} ₽ — ${selectedMonths} ${monthText}`, true);
                });
            });

            function getMonthText(months) {
                if (months === 1) return 'месяц';
                if (months >= 2 && months <= 4) return 'месяца';
                return 'месяцев';
            }

            // ---- Управление экранами ----
            function showBankSelection() {
                savedId = playerIdInput.value.trim();
                
                generatorSection.classList.add('hidden');
                bankSection.classList.add('active');
                const id = savedId || 'не указан';
                bankPriceDisplay.textContent = `Сумма: ${selectedPrice} ₽`;
                setStatus('💳', `Оплата ${selectedPrice} ₽ для ID ${id}. Выберите банк.`, true);
            }

            function showGenerator() {
                generatorSection.classList.remove('hidden');
                bankSection.classList.remove('active');
                
                if (savedId) {
                    playerIdInput.value = savedId;
                }
                
                const monthText = getMonthText(selectedMonths);
                setStatus('💡', `Выбран тариф: ${selectedPrice} ₽ — ${selectedMonths} ${monthText}. Введите ID и нажмите «Купить»`, true);
            }

            function setStatus(emoji, message, isGood = true) {
                statusEmoji.textContent = emoji;
                statusText.textContent = message;
                const statusDiv = document.getElementById('statusMessage');
                if (isGood) {
                    statusDiv.style.borderLeftColor = '#444444';
                    statusDiv.style.background = '#0a0a0a';
                } else {
                    statusDiv.style.borderLeftColor = '#884444';
                    statusDiv.style.background = '#1a0a0a';
                }
            }

            // ---- Обработчики ----
            buyBtn.addEventListener('click', function(e) {
                const rawId = playerIdInput.value.trim();
                if (!rawId) {
                    setStatus('⚠️', 'Введите ID из скрипта!', false);
                    return;
                }
                const id = Number(rawId);
                if (!Number.isInteger(id) || id <= 0) {
                    setStatus('❌', 'ID должен быть положительным целым числом', false);
                    return;
                }

                savedId = rawId;
                const monthText = getMonthText(selectedMonths);
                setStatus('✅', `ID ${id} принят. Тариф: ${selectedPrice} ₽ (${selectedMonths} ${monthText}). Выберите способ оплаты.`, true);
                setTimeout(() => {
                    showBankSelection();
                }, 300);
            });

            playerIdInput.addEventListener('keydown', (e) => {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    buyBtn.click();
                }
            });

            backLink.addEventListener('click', function(e) {
                e.preventDefault();
                showGenerator();
            });

            // ---- Клик по карточке банка - теперь ничего не делает ----
            appCards.forEach(card => {
                card.addEventListener('click', function(e) {
                    e.preventDefault();
                    // Просто показываем уведомление, что переход отключён
                    setStatus('ℹ️', 'Выбор банка — демонстрационный режим. Переход на сайты отключён.', true);
                });
            });

            // Инициализация
            showGenerator();
            console.log('✅ Готово. Выберите тариф, введите ID, нажмите «КУПИТЬ» → выберите банк.');
        })();
    </script>
</body>
</html>
